(add-hook 'post-command-hook (lambda () (setq cursor-type 'box)))
; this line changes the cursor from a line to a box in insert state of viper mode
; no idea why simple (setq cursor-type 'box) does not work
(menu-bar-mode -1)
(tool-bar-mode -1)
(scroll-bar-mode -1)
(setq inhibit-startup-screen t)
(setq initial-scratch-message nil)
(setq inhibit-startup-echo-area-message (user-login-name))
(set-fringe-mode 0)
(load-theme 'modus-vivendi t)
(global-display-line-numbers-mode 1)
(set-face-attribute 'line-number nil :background "#000000")
(blink-cursor-mode -1)
(global-hl-line-mode t)
(global-visual-line-mode 1)
(setq viper-mode t)
(require 'viper)
(define-key viper-vi-basic-map (kbd "SPC") 'execute-extended-command)
(setq viper-insert-state-cursor-color "#ffaa00")
(with-eval-after-load 'viper (add-to-list 'viper-vi-state-mode-list 'dired-mode) (setq viper-emacs-state-mode-list (delq 'dired-mode viper-emacs-state-mode-list)))
